<!DOCTYPE html>
<html lang="en">
<head>
	<title>Tim - Olimpiade MAN 2 Kota Pekanbaru</title>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">

	<link rel="stylesheet" href="/main.css">
	<link rel="stylesheet" href="/css/delegate.css">
</head>
<body>
	<%- include('partial/header.ejs') %>
	<main>
		<h1>Tim Olimpiade MAN 2 Kota Pekanbaru</h1>

		<p>Berikut arsip tim Olimpiade MAN 2 Kota Pekanbaru pada ajang Olimpiade Sains Nasional (OSN).</p>

		<div class="table-container">
			<table>
				<thead>
					<tr>
						<th>Nama</th>
						<th>Angkatan</th>
						<th>Keikutsertaan</th>
						<th>Bidang</th>
					</tr>
				</thead>
				<tbody>
					<% for (const student of students) { %>
						<tr>
							<td><a href="/student/<%- student.slug %>"><%= student.fullName %></a></td>
							<td class="number"><%= student.generation %></td>
							<td>
								<% for (const participation of student.participations) { %>
									<span class="badge participation" data-medal="<%- participation.medal %>">
										<span class="stage"><%= participation.stage %></span>
										<span class="year"><%= participation.year %></span>
									</span>
								<% } %>
							</td>
							<td>
								<% for (const subject of student.subjects) { %>
									<span class="badge subject"><%= subject %></span>
								<% } %>
							</td>
						</tr>
					<% } %>
				</tbody>
			</table>
		</div>
	</main>
</body>
</html>