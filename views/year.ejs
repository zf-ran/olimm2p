<!DOCTYPE html>
<html lang="en">
<head>
	<title>Delegasi <%= year %> - Olimpiade MAN 2 Kota Pekanbaru</title>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">

	<link rel="stylesheet" href="/main.css">
	<link rel="stylesheet" href="/css/delegate.css">
</head>
<body>
	<%- include('partial/header.ejs') %>
	<main>
		<h1>Delegasi Tahun <%= year %></h1>

		<p>Berikut delegasi MAN 2 Kota Pekanbaru pada ajang Olimpiade Sains Nasional (OSN) tahun <%= year %>.</p>

		<% for (const stage of stages) { %>
			<% if (stagedDelegates[stage.id].length == 0) continue; %>
			<h2><%= stage.displayName %></h2>
			<div class="table-container">
				<table>
					<thead>
						<tr>
							<th>Nama</th>
							<th>Bidang</th>
							<th>Peringkat</th>
						</tr>
					</thead>
					<tbody>
						<% for (const delegate of stagedDelegates[stage.id]) { %>
							<tr data-medal="<%- delegate.medalId %>">
								<td><a href="/student/<%- delegate.studentSlug %>"><%= delegate.studentFullName %></a></td>
								<td><span class="badge subject"><%= delegate.subjectName %></span></td>
								<td class="number"><%= delegate.rank %></td>
							</tr>
						<% } %>
					</tbody>
				</table>
			</div>
		<% } %>
	</main>
</body>
</html>